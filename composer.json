{
    "name": "north-web-dev/labyrinth",
    "description": "PHP drop-in anti-scraper defense: verified-crawler allowlist, heuristics, tarpit labyrinth, volume caps. No destructive payloads.",
    "type": "library",
    "keywords": ["scraper", "anti-bot", "tarpit", "labyrinth", "rate-limit", "crawler", "security"],
    "license": "MIT",
    "authors": [
        {
            "name": "North-web-dev"
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "suggest": {
        "ext-apcu": "For ApcuStore (fast per-server volume counters)",
        "ext-redis": "For RedisStore (shared volume counters across servers)"
    },
    "autoload": {
        "psr-4": {
            "NorthWebDev\\Labyrinth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NorthWebDev\\Labyrinth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
